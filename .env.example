# Sao chép file này thành .env.local rồi điền giá trị thật.

# MongoDB (bắt buộc) — có thể dùng MongoDB Atlas free tier hoặc mongod chạy local.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=wallpaper_studio

# Cloudinary (bắt buộc để upload ảnh/video hình nền)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=nextjs-seo-web

# Token tĩnh bảo vệ các API ghi dữ liệu (POST/PATCH/DELETE) — tự đặt một chuỗi ngẫu nhiên dài
ADMIN_TOKEN=

# Domain thật của site. BẮT BUỘC set khi build production: mọi canonical, og:url
# và sitemap đều sinh từ biến này — để trống là Google nhận canonical localhost.
NEXT_PUBLIC_SITE_URL=https://nnspaper.com

# Đăng nhập (NextAuth.js / Auth.js) — tạo chuỗi ngẫu nhiên: openssl rand -base64 32
AUTH_SECRET=

# URL gốc của ứng dụng, dùng cho Auth.js v5.
#
# BẮT BUỘC khi self-host production: Auth.js chỉ bật trustHost khi thấy AUTH_URL
# (hoặc AUTH_TRUST_HOST), còn NEXTAUTH_URL của v4 chỉ còn tác dụng suy ra basePath.
# Thiếu biến này thì bản build production trả UntrustedHost và không ai đăng nhập được,
# trong khi `next dev` vẫn chạy bình thường nên rất dễ lọt qua lúc phát triển.
AUTH_URL=https://nnspaper.com

# Đăng nhập Google — tạo tại https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <NEXT_PUBLIC_SITE_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Cloudflare R2 — kho riêng cho VIDEO hình nền (tuỳ chọn)
#
# Để trống cả 5 biến thì video vẫn chạy như cũ trên Cloudinary, chỉ bị chặn ở
# 100MB (trần gói Cloudinary Free). Điền đủ thì video chuyển sang R2: trần 4GB
# mỗi file và băng thông ra KHÔNG mất phí. Ảnh và poster vẫn ở Cloudinary vì R2
# không nén được và không cắt được khung hình làm poster.
#
# Lấy giá trị ở đâu (dashboard Cloudflare > R2):
#   1. Tạo bucket, ví dụ tên "nnspaper-media".
#   2. R2_ACCOUNT_ID: Account ID ở trang tổng quan R2.
#   3. R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY: R2 > Manage API Tokens >
#      Create API token, quyền "Object Read & Write", giới hạn vào bucket trên.
#      Secret chỉ hiện MỘT LẦN lúc tạo.
#   4. R2_PUBLIC_URL: bucket > Settings > Public access > Connect Domain.
#      PHẢI dùng custom domain (ví dụ https://cdn.nnspaper.com). Tên miền
#      r2.dev bị Cloudflare giới hạn tốc độ và chỉ dành cho môi trường dev.
#
# BẮT BUỘC thêm CORS cho bucket, nếu không trình duyệt sẽ bị chặn khi PUT file.
# Bucket > Settings > CORS policy:
#   [{ "AllowedOrigins": ["https://nnspaper.com", "http://localhost:3000"],
#      "AllowedMethods": ["PUT"], "AllowedHeaders": ["content-type"] }]
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
